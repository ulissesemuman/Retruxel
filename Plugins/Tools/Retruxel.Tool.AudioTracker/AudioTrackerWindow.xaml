<Window x:Class="Retruxel.Tool.AudioTracker.AudioTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUDIO TRACKER"
        Height="760" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="WindowShadow" Color="Black" Direction="270"
                              ShadowDepth="8" BlurRadius="32" Opacity="0.6"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="0" Background="{StaticResource BrushSurface}"
            BorderBrush="#262626" BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerLow}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,8,0">
                    <!-- Left: title + chip status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ARCHIVE_OS_IDE" FontFamily="Space Grotesk"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}"
                                   LetterSpacing="4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Rectangle Width="1" Height="20" Fill="#484847" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtChipStatus" FontFamily="JetBrains Mono" FontSize="10"
                                   Foreground="{StaticResource BrushPrimary}" Opacity="0.8"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: transport controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnPlay"  Width="40" Height="40" Content="▶" Click="BtnPlay_Click"
                                Style="{StaticResource ButtonSecondary}" Padding="0" Margin="1,0"/>
                        <Button x:Name="BtnStop"  Width="40" Height="40" Content="■" Click="BtnStop_Click"
                                Style="{StaticResource ButtonSecondary}" Padding="0" Margin="1,0"/>
                        <Button x:Name="BtnPause" Width="40" Height="40" Content="⏸" Click="BtnPause_Click"
                                Style="{StaticResource ButtonSecondary}" Padding="0" Margin="1,0"/>
                        <Button x:Name="BtnLoop"  Width="40" Height="40" Content="⟳" Click="BtnLoop_Click"
                                Style="{StaticResource ButtonSecondary}" Padding="0" Margin="1,0"/>
                    </StackPanel>

                    <!-- Right: BPM / SPD / mode toggle / close -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- BPM -->
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="BPM" FontSize="8" FontFamily="JetBrains Mono"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                            <TextBox x:Name="TxtBpm" Text="120" Width="40" Height="24"
                                     FontFamily="JetBrains Mono" FontSize="13"
                                     Foreground="{StaticResource BrushPrimary}"
                                     Background="{StaticResource BrushSurfaceContainerHighest}"
                                     BorderThickness="0" Padding="2,0"
                                     TextChanged="TxtBpm_TextChanged"/>
                        </StackPanel>
                        <!-- SPD -->
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="SPD" FontSize="8" FontFamily="JetBrains Mono"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                            <TextBox x:Name="TxtSpd" Text="06" Width="40" Height="24"
                                     FontFamily="JetBrains Mono" FontSize="13"
                                     Foreground="{StaticResource BrushPrimary}"
                                     Background="{StaticResource BrushSurfaceContainerHighest}"
                                     BorderThickness="0" Padding="2,0"
                                     TextChanged="TxtSpd_TextChanged"/>
                        </StackPanel>
                        <!-- Mode toggle -->
                        <Border Background="{StaticResource BrushSurfaceContainerHighest}"
                                Height="32" Padding="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnModeBasic" Content="BASIC" Height="24" Padding="10,0"
                                        FontSize="10" FontWeight="Bold"
                                        Click="BtnModeBasic_Click"
                                        Style="{StaticResource ButtonPrimary}"/>
                                <Button x:Name="BtnModeExpert" Content="EXPERT" Height="24" Padding="10,0"
                                        FontSize="10" FontWeight="Bold"
                                        Click="BtnModeExpert_Click"
                                        Style="{StaticResource ButtonGhost}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource ButtonTitleBarClose}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ CONTENT ══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT SIDEBAR: Instruments + ADSR ── -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                        BorderBrush="#262626" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="MODULE_TYPES" FontFamily="Space Grotesk" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"
                                           LetterSpacing="2"/>
                                <TextBlock x:Name="TxtSidebarVersion" Text="V.08.BETA" FontSize="9"
                                           FontFamily="JetBrains Mono"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                            </StackPanel>
                        </Border>

                        <!-- Instrument list -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Instrument List" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="16,4,16,8" TextTransform="Uppercase"/>
                                <ListBox x:Name="InstrumentListBox"
                                         Background="Transparent" BorderThickness="0"
                                         SelectionChanged="InstrumentListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="16,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushOnSurfaceVariant}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushSecondaryContainer}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOnSecondaryContainer}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtInstIndex" FontFamily="JetBrains Mono"
                                                           FontSize="9" Opacity="0.6" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TxtInstName" FontSize="11" FontWeight="Bold"
                                                           TextTransform="Uppercase"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ADSR Envelope -->
                        <Border Grid.Row="2" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ENVELOPE.ADSR" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,8" TextTransform="Uppercase"/>
                                <Border Background="{StaticResource BrushSurfaceContainerLowest}"
                                        BorderBrush="#262626" BorderThickness="1" Height="120">
                                    <Canvas x:Name="AdsrCanvas" ClipToBounds="True"/>
                                </Border>
                                <!-- ADSR values -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="A" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushOnSurfaceVariant}" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtA" Text="0" Width="28" Height="20"
                                                 FontFamily="JetBrains Mono" FontSize="10"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Background="{StaticResource BrushSurfaceContainerHighest}"
                                                 BorderThickness="0" TextAlignment="Center"
                                                 TextChanged="Adsr_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="D" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushOnSurfaceVariant}" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtD" Text="8" Width="28" Height="20"
                                                 FontFamily="JetBrains Mono" FontSize="10"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Background="{StaticResource BrushSurfaceContainerHighest}"
                                                 BorderThickness="0" TextAlignment="Center"
                                                 TextChanged="Adsr_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="S" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushOnSurfaceVariant}" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtS" Text="10" Width="28" Height="20"
                                                 FontFamily="JetBrains Mono" FontSize="10"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Background="{StaticResource BrushSurfaceContainerHighest}"
                                                 BorderThickness="0" TextAlignment="Center"
                                                 TextChanged="Adsr_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="R" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushOnSurfaceVariant}" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtR" Text="4" Width="28" Height="20"
                                                 FontFamily="JetBrains Mono" FontSize="10"
                                                 Foreground="{StaticResource BrushPrimary}"
                                                 Background="{StaticResource BrushSurfaceContainerHighest}"
                                                 BorderThickness="0" TextAlignment="Center"
                                                 TextChanged="Adsr_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CPU usage footer -->
                        <Border Grid.Row="3" Background="{StaticResource BrushSurfaceContainerLow}" Padding="16,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="MEM_USAGE" FontSize="9" FontFamily="JetBrains Mono"
                                               Foreground="{StaticResource BrushTertiary}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtMemUsage" Text="0.0KB / 64KB" FontSize="9"
                                               FontFamily="JetBrains Mono"
                                               Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="{StaticResource BrushSurfaceContainerHighest}" Height="2">
                                    <Border x:Name="MemBar" Background="{StaticResource BrushPrimary}"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── MAIN AREA ── -->
                <Grid Grid.Column="1">

                    <!-- BASIC MODE -->
                    <Grid x:Name="ViewBasic">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="88"/>
                        </Grid.RowDefinitions>

                        <!-- Arranger track -->
                        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerLow}"
                                BorderBrush="#1a1a1a" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="ArrangerPanel" Orientation="Horizontal"
                                            Margin="12,0" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Piano Roll -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Piano keys -->
                            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainerLow}"
                                    BorderBrush="#262626" BorderThickness="0,0,1,0">
                                <ScrollViewer x:Name="PianoScrollViewer"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PianoKeysPanel"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Note grid -->
                            <ScrollViewer Grid.Column="1" x:Name="PianoRollScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="PianoRollCanvas" Background="{StaticResource BrushSurfaceContainerLowest}"
                                        MouseLeftButtonDown="PianoRoll_MouseDown"
                                        MouseLeftButtonUp="PianoRoll_MouseUp"
                                        MouseMove="PianoRoll_MouseMove"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Quick Chord Matrix -->
                        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceContainerLow}"
                                Padding="16,8" BorderBrush="#1a1a1a" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="QUICK CHORD MATRIX" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="BANK_A" FontFamily="JetBrains Mono" FontSize="9"
                                               Foreground="{StaticResource BrushTertiary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel x:Name="ChordMatrixPanel" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- EXPERT MODE -->
                    <Grid x:Name="ViewExpert" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pattern Matrix -->
                        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerLow}"
                                Padding="12,8" BorderBrush="#262626" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtPatternMatrix" Text="PATTERN_MATRIX"
                                               FontFamily="Space Grotesk" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimary}" LetterSpacing="2"/>
                                    <TextBlock x:Name="TxtPatternPos" FontFamily="JetBrains Mono" FontSize="9"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Hidden">
                                    <DataGrid x:Name="PatternMatrixGrid"
                                              Background="Transparent" BorderThickness="0"
                                              GridLinesVisibility="All" HeadersVisibility="Column"
                                              RowHeight="28" FontFamily="JetBrains Mono" FontSize="10"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              IsReadOnly="False" AutoGenerateColumns="False"
                                              SelectionChanged="PatternMatrix_SelectionChanged"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Tracker spreadsheet -->
                        <Grid Grid.Row="1">
                            <!-- Column headers -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerHigh}"
                                    BorderBrush="#262626" BorderThickness="0,0,0,1">
                                <Grid x:Name="TrackerHeaderGrid" Margin="0"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" x:Name="TrackerScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TrackerRowsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="2" Background="{StaticResource BrushSurfaceContainerLow}"
                    BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="RET_TRUXEL_OS" FontFamily="Space Grotesk" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" LetterSpacing="2" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtFooterStatus" Text="STATUS: SYSTEM_READY_IDLE"
                                   FontFamily="JetBrains Mono" FontSize="9"
                                   Foreground="{StaticResource BrushTertiary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFooterMem" FontFamily="JetBrains Mono" FontSize="9"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,24,0"/>
                        <Button Content="CANCEL" Click="BtnClose_Click"
                                Style="{StaticResource ButtonGhost}" Padding="16,0" Height="28" Margin="0,0,8,0"/>
                        <Button Content="SAVE" Click="BtnSave_Click"
                                Style="{StaticResource ButtonPrimary}" Padding="16,0" Height="28"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
