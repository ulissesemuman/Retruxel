// @retruxel:version 2.5.0

// @retruxel:block header
// Generated by Retruxel — entity module (GG). Do not edit manually.
#ifndef ENTITY_{{instanceId}}_H
#define ENTITY_{{instanceId}}_H

#include "SMSlib.h"

// SAT slot assigned by SatAllocator ({{widthTiles}}x{{heightTiles}} hardware sprites)
#define ENTITY_{{instanceId}}_SAT_INDEX    {{satIndex}}
// VRAM tile offset assigned by VramAllocator
#define ENTITY_{{instanceId}}_START_TILE   {{startTile}}
// Sprite grid dimensions in 8x8 tiles
#define ENTITY_{{instanceId}}_WIDTH_TILES  {{widthTiles}}
#define ENTITY_{{instanceId}}_HEIGHT_TILES {{heightTiles}}

typedef struct {
    int           x;
    int           y;
    signed char   vx;
    signed char   vy;
    unsigned char health;
    unsigned char speed;
} Entity_{{instanceId}};

extern Entity_{{instanceId}} entity_{{instanceId}};

void entity_{{instanceId}}_init(void);
void entity_{{instanceId}}_update(void);

#endif // ENTITY_{{instanceId}}_H
// @retruxel:end

// @retruxel:block source
// Generated by Retruxel — entity module (GG). Do not edit manually.
#include "SMSlib.h"
#include "entity_{{instanceId}}.h"

{{#if isFirstInstanceWithAsset}}
// Tile data from asset: {{spriteAssetId}} — {{tilesData.tileCount}} tiles, {{tilesData.totalBytes}} bytes
const unsigned char {{spriteAssetId}}[] = { {{tilesData.tilesHex}} };
{{/if}}
{{#if isNotFirstInstanceWithAsset}}
extern const unsigned char {{spriteAssetId}}[];
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
static const unsigned char entity_{{instanceId}}_placeholder_tiles[] = { 0 };
{{/if}}

Entity_{{instanceId}} entity_{{instanceId}};

void entity_{{instanceId}}_init(void) {
    entity_{{instanceId}}.x      = {{x}};
    entity_{{instanceId}}.y      = {{y}};
    entity_{{instanceId}}.vx     = 0;
    entity_{{instanceId}}.vy     = 0;
    entity_{{instanceId}}.health = {{health}};
    entity_{{instanceId}}.speed  = {{speed}};

{{#if isFirstInstanceWithAsset}}
    SMS_loadTiles({{spriteAssetId}}, ENTITY_{{instanceId}}_START_TILE, sizeof({{spriteAssetId}}));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
    SMS_loadTiles(entity_{{instanceId}}_placeholder_tiles, ENTITY_{{instanceId}}_START_TILE, sizeof(entity_{{instanceId}}_placeholder_tiles));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}

    SMS_initSprites();
    SMS_copySpritestoSAT();
}

void entity_{{instanceId}}_update(void) {
    entity_{{instanceId}}.x += entity_{{instanceId}}.vx;
    entity_{{instanceId}}.y += entity_{{instanceId}}.vy;
    // GG screen: 160x144 — clamp to visible area minus sprite size
    if (entity_{{instanceId}}.x < 0)   entity_{{instanceId}}.x = 0;
    if (entity_{{instanceId}}.x > 151) entity_{{instanceId}}.x = 151;
    if (entity_{{instanceId}}.y < 0)   entity_{{instanceId}}.y = 0;
    if (entity_{{instanceId}}.y > 135) entity_{{instanceId}}.y = 135;

    SMS_initSprites();
    {
        unsigned char _row, _col;
        for (_row = 0; _row < ENTITY_{{instanceId}}_HEIGHT_TILES; _row++) {
            for (_col = 0; _col < ENTITY_{{instanceId}}_WIDTH_TILES; _col++) {
                unsigned char _tile_idx = _row * ENTITY_{{instanceId}}_WIDTH_TILES + _col;
                SMS_addSprite(
                    (unsigned char)(entity_{{instanceId}}.x + _col * 8),
                    (unsigned char)(entity_{{instanceId}}.y + _row * 8),
                    (unsigned char)((ENTITY_{{instanceId}}_START_TILE + _tile_idx) % 256));
            }
        }
    }
    SMS_copySpritestoSAT();
}
// @retruxel:end
