#ifndef {{entityName}}_H
#define {{entityName}}_H

#include "SMSlib.h"

#define {{entityName}}_SAT_INDEX    {{satIndex}}
#define {{entityName}}_START_TILE   {{startTile}}
#define {{entityName}}_WIDTH_TILES  {{widthTiles}}
#define {{entityName}}_HEIGHT_TILES {{heightTiles}}

{{#if hasPrefabActions}}
typedef struct {
    signed char   vel_x;
    signed char   vel_y;
    unsigned char on_ground;
    unsigned char jump_count;
    unsigned char attacking;
    unsigned char attack_cooldown;
    unsigned char attack_damage;
    unsigned char attack_range;
    unsigned char long_jump_timer;
    unsigned char long_jump_active;
    unsigned char prev_button_held;
    unsigned char coyote_frames;
} {{entityName}}_Params;
{{/if}}

typedef struct {
    int           x;
    int           y;
    signed char   vx;
    signed char   vy;
    unsigned char health;
    unsigned char speed;
{{#if hasPrefabActions}}
    {{entityName}}_Params params;
{{/if}}
} {{entityName}}_t;

extern {{entityName}}_t {{entityName}};

void {{entityName}}_init(void);
void {{entityName}}_update(void);

{{#if hasPrefabActions}}
{{#each actions}}
{{actionDecl}}
{{/each}}
{{/if}}

#endif // {{entityName}}_H
// @retruxel:end

// @retruxel:block source
#include "SMSlib.h"
#include "engine.h"
#include "{{entityName}}.h"
{{#if collisionPlaneId}}
#include "plane_{{collisionPlaneId}}.h"
{{/if}}

{{#if isFirstInstanceWithAsset}}
const unsigned char {{spriteAssetId}}[] = { {{tilesData.tilesHex}} };
{{/if}}
{{#if isNotFirstInstanceWithAsset}}
extern const unsigned char {{spriteAssetId}}[];
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
static const unsigned char {{entityName}}_placeholder_tiles[] = { 0 };
{{/if}}

{{entityName}}_t {{entityName}};

{{#if hasPrefabActions}}
{{#each actions}}
{{actionBody}}
{{/each}}
{{/if}}

void {{entityName}}_init(void) {
    {{entityName}}.x      = {{x}};
    {{entityName}}.y      = {{y}};
    {{entityName}}.vx     = 0;
    {{entityName}}.vy     = 0;
    {{entityName}}.health = {{health}};
    {{entityName}}.speed  = {{speed}};
{{#if hasPrefabActions}}
    {{entityName}}.params.vel_x            = 0;
    {{entityName}}.params.vel_y            = 0;
    {{entityName}}.params.on_ground        = 0;
    {{entityName}}.params.jump_count       = 0;
    {{entityName}}.params.attacking        = 0;
    {{entityName}}.params.attack_cooldown  = 0;
    {{entityName}}.params.attack_damage    = 1;
    {{entityName}}.params.attack_range     = 16;
    {{entityName}}.params.long_jump_timer  = 0;
    {{entityName}}.params.long_jump_active = 0;
    {{entityName}}.params.prev_button_held = 0;
    {{entityName}}.params.coyote_frames    = 0;
{{/if}}
{{#if isFirstInstanceWithAsset}}
    SMS_loadTiles({{spriteAssetId}}, {{entityName}}_START_TILE, sizeof({{spriteAssetId}}));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
    SMS_loadTiles({{entityName}}_placeholder_tiles, {{entityName}}_START_TILE, sizeof({{entityName}}_placeholder_tiles));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}
    // SAT is managed exclusively by the main loop — no init/copy here
{{#if hasPrefabActions}}
{{#each actions}}
{{#if trigger == "OnStart"}}
    {{entityName}}_action_{{actionId}}(&{{entityName}}.params);
{{/if}}
{{/each}}
{{/if}}
}

void {{entityName}}_update(void) {
{{#if hasInputMapping}}
    {
{{#each actions}}
{{#if trigger == "OnInput"}}
{{actionReset}}
{{/if}}
{{/each}}
{{#each inputMappings}}
{{#each actionCalls}}
{{#if inverted}}
        if (!({{keysFunc}}() & {{devkitConst}})) {
            {{entityName}}_action_{{actionId}}(&{{entityName}}.params{{#if callArgs}}, {{callArgs}}{{/if}});
        }
{{/if}}
{{#ifnot inverted}}
        if ({{keysFunc}}() & {{devkitConst}}) {
            {{entityName}}_action_{{actionId}}(&{{entityName}}.params{{#if callArgs}}, {{callArgs}}{{/if}});
        }
{{/ifnot}}
{{/each}}
{{/each}}
    }
{{/if}}

{{#if hasPrefabActions}}
    {
        int next_x = {{entityName}}.x + (int){{entityName}}.params.vel_x;
        int next_y = {{entityName}}.y + ((int){{entityName}}.params.vel_y >> 3);

{{#if collisionPlaneId}}
{{#if collisionIsSolid}}
        unsigned char left_tx        = (unsigned char)(next_x >> 3);
        unsigned char left_ty_top    = (unsigned char)(next_y >> 3);
        unsigned char left_ty_mid    = (unsigned char)((next_y + ({{entityName}}_HEIGHT_TILES << 2)) >> 3);
        unsigned char left_ty_bottom = (unsigned char)(((next_y + ({{entityName}}_HEIGHT_TILES << 3)) - 1) >> 3);
        if ({{entityName}}.params.vel_x < 0) {
            unsigned char collided = 0;
            if (left_ty_top    < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && left_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(left_tx, left_ty_top))    collided = 1;
            if (left_ty_mid    < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && left_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(left_tx, left_ty_mid))    collided = 1;
            if (left_ty_bottom < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && left_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(left_tx, left_ty_bottom)) collided = 1;
            if (collided) { next_x = (left_tx + 1) << 3; {{entityName}}.params.vel_x = 0; }
        }
        unsigned char right_tx        = (unsigned char)(((next_x + ({{entityName}}_WIDTH_TILES << 3)) - 1) >> 3);
        unsigned char right_ty_top    = (unsigned char)(next_y >> 3);
        unsigned char right_ty_mid    = (unsigned char)((next_y + ({{entityName}}_HEIGHT_TILES << 2)) >> 3);
        unsigned char right_ty_bottom = (unsigned char)(((next_y + ({{entityName}}_HEIGHT_TILES << 3)) - 1) >> 3);
        if ({{entityName}}.params.vel_x > 0) {
            unsigned char collided = 0;
            if (right_ty_top    < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && right_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(right_tx, right_ty_top))    collided = 1;
            if (right_ty_mid    < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && right_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(right_tx, right_ty_mid))    collided = 1;
            if (right_ty_bottom < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && right_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(right_tx, right_ty_bottom)) collided = 1;
            if (collided) { next_x = (right_tx << 3) - ({{entityName}}_WIDTH_TILES << 3); {{entityName}}.params.vel_x = 0; }
        }
{{/if}}
{{/if}}

        unsigned char foot_tx_left  = (unsigned char)(next_x >> 3);
        unsigned char foot_tx_right = (unsigned char)(((next_x + ({{entityName}}_WIDTH_TILES << 3)) - 1) >> 3);
        unsigned char foot_ty = (unsigned char)(((next_y + ({{entityName}}_HEIGHT_TILES << 3)) - 1) >> 3);
        unsigned char head_ty = (unsigned char)(next_y >> 3);

        {{entityName}}.params.on_ground = 0;
{{#if collisionPlaneId}}
{{#if collisionIsSolid}}
        if ({{entityName}}.params.vel_y < 0) {
            unsigned char collided = 0;
            if (head_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_left  < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_left,  head_ty)) collided = 1;
            if (head_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_right < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_right, head_ty)) collided = 1;
            if (collided) {
                next_y = (head_ty + 1) << 3;
                {{entityName}}.params.vel_y        = 0;
                {{entityName}}.params.long_jump_active = 0;
                {{entityName}}.params.long_jump_timer  = 0;
            }
        }
        if ({{entityName}}.params.vel_y >= 0) {
            unsigned char collided = 0;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_left  < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_left,  foot_ty)) collided = 1;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_right < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_right, foot_ty)) collided = 1;
            if (collided) {
                next_y = (foot_ty << 3) - ({{entityName}}_HEIGHT_TILES << 3);
                {{entityName}}.params.vel_y      = 0;
                {{entityName}}.params.on_ground  = 1;
                {{entityName}}.params.jump_count = 0;
            }
        }
{{/if}}
{{#if collisionIsPlatform}}
        if ({{entityName}}.params.vel_y < 0) {
            unsigned char collided = 0;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_left  < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_left,  foot_ty)) collided = 1;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_right < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_right, foot_ty)) collided = 1;
            if (collided) {
                int invasion = (next_y + ({{entityName}}_HEIGHT_TILES << 3)) - (foot_ty << 3);
                if (invasion <= {{snapPixels}}) {
                    next_y = (foot_ty << 3) - ({{entityName}}_HEIGHT_TILES << 3);
                    {{entityName}}.params.vel_y      = 0;
                    {{entityName}}.params.on_ground  = 1;
                    {{entityName}}.params.jump_count = 0;
                }
            }
        }
        if ({{entityName}}.params.vel_y > 0) {
            unsigned char collided = 0;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_left  < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_left,  foot_ty)) collided = 1;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_right < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_right, foot_ty)) collided = 1;
            if (collided) {
                next_y = (foot_ty << 3) - ({{entityName}}_HEIGHT_TILES << 3);
                {{entityName}}.params.vel_y      = 0;
                {{entityName}}.params.on_ground  = 1;
                {{entityName}}.params.jump_count = 0;
            }
        }
        if ({{entityName}}.params.vel_y == 0) {
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_left  < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_left,  foot_ty)) {{entityName}}.params.on_ground = 1;
            if (foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT && foot_tx_right < PLANE_{{collisionPlaneId}}_MAP_WIDTH && plane_{{collisionPlaneId}}_solid_at(foot_tx_right, foot_ty)) {{entityName}}.params.on_ground = 1;
        }
{{/if}}
{{/if}}

        {{entityName}}.x = next_x;
        {{entityName}}.y = next_y;

        {{#if spriteBorderBehavior == "Clamp"}}
        {
            int minX = 0, maxX = 256 - ({{entityName}}_WIDTH_TILES << 3);
            int minY = -(({{entityName}}_HEIGHT_TILES - 1) << 3), maxY = 192 - ({{entityName}}_HEIGHT_TILES << 3);
            if ({{entityName}}.x < minX) {{entityName}}.x = minX;
            if ({{entityName}}.x > maxX) {{entityName}}.x = maxX;
            if ({{entityName}}.y < minY) {{entityName}}.y = minY;
            if ({{entityName}}.y > maxY) {{entityName}}.y = maxY;
        }
        {{/if}}
        {{#if spriteBorderBehavior == "Wrap"}}
        {
            int sw = {{entityName}}_WIDTH_TILES << 3, sh = {{entityName}}_HEIGHT_TILES << 3;
            if ({{entityName}}.x < -sw)  {{entityName}}.x = 256;
            if ({{entityName}}.x > 256)  {{entityName}}.x = -sw;
            if ({{entityName}}.y < -sh)  {{entityName}}.y = 192;
            if ({{entityName}}.y > 192)  {{entityName}}.y = -sh;
        }
        {{/if}}

        if ({{entityName}}.params.attack_cooldown > 0)
            {{entityName}}.params.attack_cooldown--;
    }
{{/if}}

{{#if hasPrefabActions}}
{{#each actions}}
{{#if trigger == "OnVBlank"}}
{{actionUpdate}}
{{/if}}
{{/each}}
{{/if}}

    // ── Draw sprite
    {
        unsigned char _row, _col;
        for (_row = 0; _row < {{entityName}}_HEIGHT_TILES; _row++) {
            for (_col = 0; _col < {{entityName}}_WIDTH_TILES; _col++) {
                int _spr_x = {{entityName}}.x + (_col << 3);
                int _spr_y = {{entityName}}.y + (_row << 3);
                {{#if spriteBorderBehavior == "None"}}
                if (_spr_x >= -8 && _spr_x <= 256 && _spr_y >= -16 && _spr_y <= 192) {
                {{/if}}
                SMS_addSprite((unsigned char)_spr_x, (unsigned char)_spr_y,
                    (unsigned char)(({{entityName}}_START_TILE + _row * {{entityName}}_WIDTH_TILES + _col) & 0xFF));
                {{#if spriteBorderBehavior == "None"}}
                }
                {{/if}}
            }
        }
    }
}
// @retruxel:end
