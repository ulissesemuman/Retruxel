// Splash screen - Made with Retruxel
// Generated by Retruxel — do not edit manually
#include "SMSlib.h"
#include "splash.h"

// Splash timing
#define SPLASH_FADE_IN_FRAMES  {{fadeInDuration}}
#define SPLASH_HOLD_FRAMES    {{holdDuration}}
#define SPLASH_FADE_OUT_FRAMES {{fadeOutDuration}}

// Splash image dimensions (144x112 pixels = 18x14 tiles)
#define SPLASH_TILES_X 18
#define SPLASH_TILES_Y 14
#define SPLASH_OFFSET_X 7
#define SPLASH_OFFSET_Y 5

// Tile data (generated from splash asset)
{{#each splashAsset}}
const unsigned char splash_tiles[] = {
    {{tilesData.tilesHex}}
};

// Palette (generated from splash asset)
static const unsigned char splash_palette_target[32] = {
    {{palette0Hex}},
    {{palette1Hex}}
};

// Working palette buffer
static unsigned char splash_palette_current[32];

// Step a single SMS color byte toward its target
static unsigned char splash_step_color(unsigned char current, unsigned char target, signed char step) {
    unsigned char rr_cur = (current     ) & 0x03;
    unsigned char gg_cur = (current >> 2) & 0x03;
    unsigned char bb_cur = (current >> 4) & 0x03;
    unsigned char rr_tgt = (target     ) & 0x03;
    unsigned char gg_tgt = (target >> 2) & 0x03;
    unsigned char bb_tgt = (target >> 4) & 0x03;
    
    if (step > 0) {
        if (rr_cur < rr_tgt) rr_cur++;
        if (gg_cur < gg_tgt) gg_cur++;
        if (bb_cur < bb_tgt) bb_cur++;
    } else {
        if (rr_cur > 0) rr_cur--;
        if (gg_cur > 0) gg_cur--;
        if (bb_cur > 0) bb_cur--;
    }
    
    return (bb_cur << 4) | (gg_cur << 2) | rr_cur;
}

// Advance palette one step toward target (fade in) or black (fade out)
static void splash_fade_step(signed char direction) {
    static unsigned char fade_counter = 0;
    fade_counter++;
    if (fade_counter < 10) return;  // Only step every 10 frames
    fade_counter = 0;
    
    for (unsigned char i = 0; i < 32; i++) {
        unsigned char tgt = (direction > 0) ? splash_palette_target[i] : 0;
        splash_palette_current[i] = splash_step_color(
            splash_palette_current[i], tgt, direction);
    }
    
    SMS_loadBGPalette(splash_palette_current);
    SMS_loadSpritePalette(splash_palette_current + 16);
}

// Show splash screen
void splash_show(void) {
    unsigned char i, row;
    
    // Clear screen and load splash tiles
    SMS_VRAMmemsetW(0, 0x0000, 16384);
    SMS_loadTiles(splash_tiles, 0, sizeof(splash_tiles));
    
    // Load nametable centered on screen
    for (row = 0; row < SPLASH_TILES_Y; row++) {
        SMS_loadTileMap(SPLASH_OFFSET_X, SPLASH_OFFSET_Y + row, splash_map + (row * SPLASH_TILES_X), SPLASH_TILES_X * 2);
    }
    
    // Start with black palette
    for (i = 0; i < 32; i++) splash_palette_current[i] = 0;
    SMS_loadBGPalette(splash_palette_current);
    SMS_loadSpritePalette(splash_palette_current + 16);
    
    SMS_displayOn();
    
    // Fade in
    for (i = 0; i < SPLASH_FADE_IN_FRAMES; i++) {
        SMS_waitForVBlank();
        splash_fade_step(1);
    }
    
    // Hold
    for (i = 0; i < SPLASH_HOLD_FRAMES; i++) {
        SMS_waitForVBlank();
    }
    
    // Fade out
    for (i = 0; i < SPLASH_FADE_OUT_FRAMES; i++) {
        SMS_waitForVBlank();
        splash_fade_step(-1);
    }
    
    // Clean up
    SMS_displayOff();
    SMS_VRAMmemsetW(0, 0x0000, 16384);
}
