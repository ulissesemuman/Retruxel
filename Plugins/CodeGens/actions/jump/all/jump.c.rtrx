// @retruxel:block header
void entity_{{entityId}}_action_jump(Entity_{{entityId}}_Params* p);
// @retruxel:end

// @retruxel:block source
// Action: jump — injected into entity_{{entityId}}
void entity_{{entityId}}_action_jump(Entity_{{entityId}}_Params* p) {
    {{#if params.canDouble}}
    if (p->on_ground) p->jump_count = 0;
    if (p->jump_count >= 2) return;
    p->jump_count++;
    {{/if}}
    {{#ifnot params.canDouble}}
    if (!p->on_ground) return;
    {{/ifnot}}
    p->vel_y = -{{params.jumpHeight}};
    p->on_ground = 0;
}
// @retruxel:end
