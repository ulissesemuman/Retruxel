// @retruxel:block header
void entity_{{entityId}}_action_gravity(Entity_{{entityId}}_Params* p);
// @retruxel:end

// @retruxel:block source
// Action: gravity — injected into entity_{{entityId}}
// vel_y in subpixels (1/8 px). Applied to position via >> 3 in physics block.
void entity_{{entityId}}_action_gravity(Entity_{{entityId}}_Params* p) {
    if (p->on_ground) return;
    p->vel_y += {{params.strength}};
    if (p->vel_y > {{params.maxFallSpeed}}) p->vel_y = {{params.maxFallSpeed}};
}
// @retruxel:end

// @retruxel:block update
    entity_{{entityId}}_action_gravity(&entity_{{entityId}}.params);
// @retruxel:end
