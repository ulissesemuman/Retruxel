<Window x:Class="Retruxel.Tool.SpriteEditor.Views.HitboxTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Hitbox"
        Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushOutlineVariant}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Name" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Text="Box" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Type" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbType" Height="32" SelectedIndex="1">
                    <ComboBoxItem Content="Hitbox (deals damage)"/>
                    <ComboBoxItem Content="Hurtbox (receives damage)"/>
                    <ComboBoxItem Content="Solidbox (blocks movement)"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="4" 
                   Text="Draw the box on the canvas after adding."
                   Style="{StaticResource TextLabel}"
                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Style="{StaticResource ButtonGhost}" 
                    Click="BtnCancel_Click" Width="80" Height="32" Margin="0,0,8,0"/>
                <Button Content="ADD" Style="{StaticResource ButtonPrimary}" 
                    Click="BtnAdd_Click" Width="80" Height="32"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
