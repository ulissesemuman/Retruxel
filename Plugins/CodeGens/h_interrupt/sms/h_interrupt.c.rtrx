// @retruxel:block header
// H-Interrupt scanline palette effect for SMS VDP
// Generated by Retruxel — do not edit manually.
#ifndef H_INTERRUPT_H
#define H_INTERRUPT_H

#include "SMSlib.h"

/**
 * H-Interrupt enables mid-frame palette swaps on the SMS VDP.
 *
 * The VDP fires a horizontal interrupt every N scanlines (configured via
 * VDP register #10). The interrupt handler runs between scanlines and can
 * write new palette colors to CRAM before the next line is rendered.
 *
 * This enables:
 *   - Sky gradients (blue → lighter blue at horizon)
 *   - Underground color zones
 *   - Water ripple effects
 *   - Day/night cycles split by scanline
 *
 * Configuration:
 *   scanlineInterval = {{scanlineInterval}}   (interrupt every N lines)
 *   numBands         = {{numBands}}           (number of palette swaps per frame)
 *   swapSlot         = {{swapSlot}}           (0 = BG palette, 1 = Sprite palette)
 *   colorIndex       = {{colorIndex}}         (palette color index to change, 0-15)
 *
 * Usage:
 *   1. Define h_interrupt_band_colors[] with your band colors (RGB222 format).
 *   2. Call h_interrupt_init() in scene_init().
 *   3. The interrupt fires automatically — no update call needed.
 *
 * RGB222 format: 0b00BBGGRR (2 bits per channel, values 0-3)
 *   Example: pure red = 0x03, pure green = 0x0C, pure blue = 0x30
 */

#define H_INT_NUM_BANDS    {{numBands}}
#define H_INT_SWAP_SLOT    {{swapSlot}}
#define H_INT_COLOR_INDEX  {{colorIndex}}

/* Fill this array with RGB222 colors for each scanline band.
   Index 0 = top of screen, index N-1 = bottom. */
extern unsigned char h_interrupt_band_colors[H_INT_NUM_BANDS];

void h_interrupt_init(void);
void h_interrupt_set_band(unsigned char band, unsigned char rgb222_color);

#endif // H_INTERRUPT_H
// @retruxel:end

// @retruxel:block source
#include "h_interrupt.h"

/* Current band index — incremented by the interrupt handler each time it fires */
static unsigned char _h_int_band = 0;

/* Band color table — user fills this before calling h_interrupt_init() */
unsigned char h_interrupt_band_colors[H_INT_NUM_BANDS] = {
    {{#each_n numBands}}0x00{{#unless @last}}, {{/unless}}{{/each_n}}
};

/* H-Interrupt handler — called by the VDP between scanlines.
   Writes the next band color to CRAM at the configured slot + index. */
void SMS_HINTERRUPT_HANDLER h_int_handler(void) {
    if (_h_int_band < H_INT_NUM_BANDS) {
        unsigned int cram_addr = (H_INT_SWAP_SLOT == 0)
            ? H_INT_COLOR_INDEX              /* BG palette: CRAM 0-15  */
            : (16 + H_INT_COLOR_INDEX);      /* Sprite palette: CRAM 16-31 */

        SMS_setColor(cram_addr, h_interrupt_band_colors[_h_int_band]);
        _h_int_band++;
    }
}

void h_interrupt_init(void) {
    _h_int_band = 0;

    /* Set H-Interrupt line counter: fires every scanlineInterval lines */
    SMS_write_to_VDP_register(10, {{scanlineInterval}} - 1);

    /* Enable H-Interrupt in VDP register #1 */
    SMS_VDP_ENABLE_DISPLAY_ON;

    /* Register the handler — SMSlib calls it automatically on HInt */
    SMS_setInterruptHandler(h_int_handler);
}

void h_interrupt_set_band(unsigned char band, unsigned char rgb222_color) {
    if (band < H_INT_NUM_BANDS)
        h_interrupt_band_colors[band] = rgb222_color;
}

/* Reset band counter each VBlank so the effect repeats every frame */
void h_interrupt_vblank_reset(void) {
    _h_int_band = 0;
}
// @retruxel:end
