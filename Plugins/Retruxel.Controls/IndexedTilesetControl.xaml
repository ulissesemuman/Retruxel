<UserControl x:Class="Retruxel.Controls.IndexedTilesetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        IndexedTilesetControl — reusable tileset viewer.
        The Canvas is the only visual element. All content (bitmap, grid, selection)
        is added programmatically in code-behind.

        The UserControl itself has no background — the host is responsible for
        placing this inside a ScrollViewer with the desired background color.
    -->
    <Canvas x:Name="TilesetCanvas"
            Background="Transparent"
            MouseLeftButtonDown="TilesetCanvas_MouseLeftButtonDown"
            MouseMove="TilesetCanvas_MouseMove"
            MouseLeftButtonUp="TilesetCanvas_MouseLeftButtonUp"/>

</UserControl>
