{
  "moduleId": "plane",
  "targetId": "sms",
  "displayName": "SMS Plane CodeGen",
  "description": "Generates C code for SMS plane with collision detection using bitfield lookup",
  "version": "1.1.0",
  "template": "plane.c.rtrx",
  "variables": {
    "tilesAssetId": { "from": "module", "path": "tilesAssetId", "default": "" },
    "tileAssets":   { "from": "module", "path": "tileAssets",   "default": [] },
    "mapAssetId": { "from": "module", "path": "mapAssetId", "default": "" },
    "startTile": { "from": "module", "path": "startTile", "default": 0 },
    "mapX": { "from": "module", "path": "mapX", "default": 0 },
    "mapY": { "from": "module", "path": "mapY", "default": 0 },
    "mapWidth": { "from": "module", "path": "mapWidth", "default": 32 },
    "mapHeight": { "from": "module", "path": "mapHeight", "default": 24 },
    "tiles": { "from": "module", "path": "tiles", "default": [] },
    "solidTiles": { "from": "module", "path": "solidTiles", "default": [] },
    "maxTileSlots": { "from": "module", "path": "maxTileSlots", "default": 448 },
    "paletteSlot": { "from": "module", "path": "paletteSlot", "default": 0 },
    "tilesData": {
      "from": "tool",
      "tool": "png_to_tiles",
      "toolInput": {
        "assetId": "tilesAssetId"
      }
    },
    "preprocessed": {
      "from": "tool",
      "tool": "plane_preprocessor",
      "toolInput": {
        "solidTiles": "solidTiles",
        "tiles": "tiles",
        "startTile": "startTile",
        "mapX": "mapX",
        "mapY": "mapY",
        "mapWidth": "mapWidth",
        "mapHeight": "mapHeight",
        "maxTileSlots": "maxTileSlots",
        "paletteSlot": "paletteSlot"
      }
    }
  }
}
