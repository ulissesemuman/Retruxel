<Window x:Class="Retruxel.Tool.PrefabEditor.PrefabEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="860"
        MinWidth="720" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BrushSurfaceContainerLow}"
            BorderThickness="1"
            BorderBrush="{StaticResource BrushSurfaceContainerHighest}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable content -->
                <RowDefinition Height="40"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── TITLE BAR ─────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PREFAB_EDITOR"
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPrefabId"
                                   Style="{StaticResource TextCode}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnClose"
                            Grid.Column="1"
                            Content="× CLOSE"
                            Style="{StaticResource ButtonGhost}"
                            FontSize="10"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ── SCROLLABLE CONTENT ────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" Margin="24,16,24,16">

                    <!-- IDENTITY -->
                    <TextBlock Text="IDENTITY"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NAME (IDENTIFIER) *"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BrushSurfaceContainerLow}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource BrushSurfaceContainerHighest}"
                                    Height="32">
                                <TextBox x:Name="TxtName"
                                         Background="{StaticResource BrushSurfaceContainerLow}"
                                         Foreground="{StaticResource BrushOnSurface}"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         VerticalContentAlignment="Center"
                                         Padding="4,0"
                                         TextChanged="TxtName_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="TxtNameError"
                                       Foreground="{StaticResource BrushError}"
                                       FontSize="10"
                                       Margin="0,2,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Display Name -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DISPLAY NAME"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BrushSurfaceContainerLow}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource BrushSurfaceContainerHighest}"
                                    Height="32">
                                <TextBox x:Name="TxtDisplayName"
                                         Background="{StaticResource BrushSurfaceContainerLow}"
                                         Foreground="{StaticResource BrushOnSurface}"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Padding="4,0"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- SPRITE -->
                    <Border Height="1" Background="{StaticResource BrushSurfaceContainerHighest}" Margin="0,16,0,16"/>
                    <TextBlock Text="SPRITE"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sprite preview -->
                        <Border Grid.Column="0"
                                Width="128" Height="128"
                                Background="{StaticResource BrushSurface}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushSurfaceContainerHighest}">
                            <Grid>
                                <Image x:Name="ImgSpritePreview"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="TxtNoSprite"
                                           Text="NO ASSET"
                                           Style="{StaticResource TextLabelCaps}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Sprite controls -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">

                            <!-- Asset Source -->
                            <TextBlock Text="ASSET SOURCE"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbAsset"
                                          Grid.Column="0"
                                          Height="32"
                                          SelectionChanged="CmbAsset_SelectionChanged"/>
                                <Button x:Name="BtnOpenSpriteEditor"
                                        Grid.Column="2"
                                        Content="✏ SPRITE EDITOR"
                                        Style="{StaticResource ButtonSecondary}"
                                        Height="32"
                                        Click="BtnOpenSpriteEditor_Click"/>
                            </Grid>

                            <!-- Palette Slot -->
                            <TextBlock Text="PALETTE SLOT"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbPaletteSlot"
                                      Height="32"
                                      Margin="0,0,0,12"
                                      SelectionChanged="CmbPaletteSlot_SelectionChanged"/>

                            <!-- Dimensions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="WIDTH (TILES)"
                                               Style="{StaticResource TextLabelCaps}"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BrushSurfaceContainerLow}"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource BrushSurfaceContainerHighest}"
                                            Height="32">
                                        <TextBox x:Name="TxtWidthTiles"
                                                 Background="{StaticResource BrushSurfaceContainerLow}"
                                                 Foreground="{StaticResource BrushOnSurface}"
                                                 BorderThickness="0"
                                                 FontFamily="Consolas"
                                                 VerticalContentAlignment="Center"
                                                 Padding="4,0"
                                                 Text="2"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="HEIGHT (TILES)"
                                               Style="{StaticResource TextLabelCaps}"
                                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                                               Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BrushSurfaceContainerLow}"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource BrushSurfaceContainerHighest}"
                                            Height="32">
                                        <TextBox x:Name="TxtHeightTiles"
                                                 Background="{StaticResource BrushSurfaceContainerLow}"
                                                 Foreground="{StaticResource BrushOnSurface}"
                                                 BorderThickness="0"
                                                 FontFamily="Consolas"
                                                 VerticalContentAlignment="Center"
                                                 Padding="4,0"
                                                 Text="2"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ACTIONS -->
                    <Border Height="1" Background="{StaticResource BrushSurfaceContainerHighest}" Margin="0,16,0,16"/>
                    <TextBlock Text="ACTIONS"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushPrimary}"
                               Margin="0,0,0,12"/>

                    <StackPanel x:Name="ActionsPanel" Margin="0,0,0,8"/>

                    <Button x:Name="BtnAddAction"
                            Height="40"
                            Margin="0,0,0,0"
                            Click="BtnAddAction_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceContainerHighest}"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="+ ADD ACTION"
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                    </Button>

                    <!-- INPUT MAPPING -->
                    <Border Height="1" Background="{StaticResource BrushSurfaceContainerHighest}" Margin="0,16,0,16"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INPUT MAPPING"
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushPrimary}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnToggleInput"
                                Grid.Column="1"
                                Height="24"
                                Style="{StaticResource ButtonSecondary}"
                                Click="BtnToggleInput_Click"/>
                    </Grid>

                    <!-- Input mapping content (shown when InputMapping != null) -->
                    <StackPanel x:Name="InputMappingPanel">

                        <!-- Port selector -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONTROLLER PORT"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbPort"
                                      Grid.Column="2"
                                      Height="32"
                                      SelectionChanged="CmbPort_SelectionChanged"/>
                        </Grid>

                        <!-- Button rows generated in code-behind -->
                        <StackPanel x:Name="ButtonMappingPanel"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ── FOOTER ─────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BrushSurfaceContainerHighest}">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCancel"
                            Grid.Column="0"
                            Content="CANCEL"
                            Style="{StaticResource ButtonGhost}"
                            Width="100"
                            Click="BtnCancel_Click"/>

                    <TextBlock x:Name="TxtValidationError"
                               Grid.Column="1"
                               Foreground="{StaticResource BrushError}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>

                    <Button x:Name="BtnSave"
                            Grid.Column="2"
                            Content="SAVE"
                            Style="{StaticResource ButtonPrimary}"
                            Width="100"
                            Click="BtnSave_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
