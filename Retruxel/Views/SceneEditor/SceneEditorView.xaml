<UserControl x:Class="Retruxel.Views.SceneEditorView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:loc="clr-namespace:Retruxel.Localization"
          Background="{StaticResource BrushSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" MaxWidth="420"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
            Background="{StaticResource BrushSurfaceContainerLow}"
            Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scene tabs -->
                <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Stretch">
                    <StackPanel x:Name="SceneTabsPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"/>
                </ScrollViewer>

                <!-- Zoom + coordinates -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="TxtCoordinates"
                           Text="X: 0 | Y: 0"
                           Style="{StaticResource TextLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                    <Button x:Name="BtnPreviewZoom"
                        Content="100%"
                        Style="{StaticResource ButtonGhost}"
                        Width="64" Height="24"
                        Padding="0"
                        Click="BtnPreviewZoom_Click"
                        ToolTip="Zoom options"/>
                </StackPanel>

                <!-- Right controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtSaveIndicator"
                           Text="💾"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Opacity="0.3"
                           ToolTip="Auto-save"/>
                    <Button x:Name="BtnUndo"
                        Content="↩"
                        IsEnabled="False"
                        ToolTip="Nothing to undo"
                        Style="{StaticResource ButtonTitleBar}"
                        Click="BtnUndo_Click"/>
                    <Button x:Name="BtnRedo"
                        Content="↪"
                        IsEnabled="False"
                        ToolTip="Nothing to redo"
                        Style="{StaticResource ButtonTitleBar}"
                        Click="BtnRedo_Click"/>
                    <Button x:Name="BtnGenerateRom"
                        Content="{loc:Tr Key='scene.generate_rom'}"
                        Style="{StaticResource ButtonPrimary}"
                        Padding="16,0" Height="28"
                        Click="GenerateRom_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LEFT — PROJECT TREE ===== -->
        <Border Grid.Row="1" Grid.Column="0"
            Background="{StaticResource BrushSurfaceContainerLow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ProjectTreePanel" Margin="0,8,0,8"/>
            </ScrollViewer>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{StaticResource BrushSurface}"
                  ShowsPreview="False"/>

        <!-- ===== CENTER — SCENE PREVIEW ===== -->
        <Border Grid.Row="1" Grid.Column="2"
            Background="{StaticResource BrushSurface}"
            ClipToBounds="True"
            x:Name="PreviewHost"
            MouseWheel="PreviewHost_MouseWheel"
            MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
            MouseMove="PreviewHost_MouseMove"
            MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp"
            MouseDown="PreviewHost_MouseDown"
            MouseUp="PreviewHost_MouseUp">
            <Grid>

                <Canvas x:Name="PreviewCanvas"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                    <Canvas.Background>
                        <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,16,16"
                                  ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FF0D0D0D">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,16,16"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FF111111">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                <RectangleGeometry Rect="8,8,8,8"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Canvas.Background>

                    <Rectangle x:Name="ScreenBorder"
                           Stroke="#3a3a3a"
                           StrokeThickness="1"
                           Fill="Transparent"
                           IsHitTestVisible="False"/>

                    <Canvas x:Name="SceneCanvas"
                        IsHitTestVisible="False"/>

                </Canvas>

                <!-- Empty state overlay -->
                <StackPanel x:Name="PreviewEmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="SCENE PREVIEW"
                           Style="{StaticResource TextLabelCaps}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                    <TextBlock Text="Add planes and entities in the project tree to see them here."
                           Style="{StaticResource TextBody}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="240"
                           TextAlignment="Center"/>
                </StackPanel>

                <!-- Canvas size label -->
                <TextBlock x:Name="TxtCanvasSize"
                       Style="{StaticResource TextLabel}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,8,8"
                       Foreground="{StaticResource BrushOnSurfaceVariant}"/>
            </Grid>
        </Border>

        <!-- ===== RIGHT — PROPERTIES + DIAGNOSTICS ===== -->
        <Border Grid.Row="1" Grid.Column="3"
            Background="{StaticResource BrushSurfaceContainerLow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="220" MinHeight="80" MaxHeight="400"/>
                </Grid.RowDefinitions>

                <!-- Properties -->
                <Grid Grid.Row="0" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                           x:Name="TxtPropertiesTitle"
                           Text="PROPERTIES"
                           Style="{StaticResource TextLabelCaps}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="TxtNoSelection"
                                   Text="{loc:Tr Key='scene.no_selection'}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Visibility="Visible"/>

                            <StackPanel x:Name="PropertiesPanel"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BrushSurface}"
                          ShowsPreview="False"/>

                <!-- Diagnostics passivos -->
                <Border Grid.Row="2"
                        Background="{StaticResource BrushSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                               Text="HARDWARE USAGE"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="16,8,16,4"/>

                        <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DiagnosticsPanel" Margin="16,0,16,12"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>