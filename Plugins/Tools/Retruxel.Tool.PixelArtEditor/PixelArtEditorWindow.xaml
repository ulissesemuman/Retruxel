<Window x:Class="Retruxel.Tool.PixelArtEditor.PixelArtEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIXEL ART EDITOR"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="WindowShadow"
                              Color="Black" Direction="270"
                              ShadowDepth="8" BlurRadius="32" Opacity="0.6"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="6"
            Background="{StaticResource BrushSurface}"
            BorderBrush="#3a3a3a"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurfaceContainerLow}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle"
                                   Text="PIXEL ART EDITOR"
                                   Style="{StaticResource TextHeadline}"
                                   Foreground="{StaticResource BrushPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtTileName"
                                   Text="—"
                                   Style="{StaticResource TextHeadline}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtTargetLabel"
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Style="{StaticResource ButtonTitleBarClose}"/>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="180" MaxWidth="600"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL - TILESET -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushSurfaceContainerLow}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="LblTilesetAsset"
                                       Text="TILES ASSET"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbTilesetAsset"
                                      SelectionChanged="CmbTilesetAsset_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,0">
                            <TextBlock Text="TOOLS"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnToolPencil" Content="LAPIS" Click="BtnToolPencil_Click"/>
                                <Button x:Name="BtnToolBucket" Content="BALDE" Margin="8,0,0,0" Click="BtnToolBucket_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnToolSelect" Content="SELEC" Click="BtnToolSelect_Click"/>
                                <Button x:Name="BtnToolMirror" Content="ESPELHO" Margin="8,0,0,0" Click="BtnToolMirror_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="Zoom tile:" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnTileZoom" Content="100%" Click="BtnTileZoom_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtVramRegionInfo"
                                   Grid.Row="4"
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   TextWrapping="Wrap"/>

                        <ScrollViewer x:Name="TilesetScrollViewer"
                                      Grid.Row="6"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <Canvas x:Name="TilesetCanvas"
                                    Background="{StaticResource BrushSurface}"
                                    MouseLeftButtonDown="TilesetCanvas_MouseLeftButtonDown"/>
                        </ScrollViewer>

                        <Border Grid.Row="8"
                                Background="{StaticResource BrushSurfaceContainerHigh}"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="SELECTED TILE" Style="{StaticResource TextLabelCaps}" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,6"/>
                                <Image x:Name="ImgSelectedTile"
                                       Width="96" Height="96"
                                       Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource BrushSurface}"
                              ShowsPreview="False"/>

                <!-- CENTER PANEL - CANVAS -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushSurface}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerHigh}">
                            <ScrollViewer x:Name="CanvasScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="EditorCanvas"
                                        Background="Transparent"
                                        MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                                        MouseMove="EditorCanvas_MouseMove"
                                        MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp"
                                        MouseWheel="EditorCanvas_MouseWheel"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Zoom:" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnCanvasZoom" Content="100%" Style="{StaticResource ButtonGhost}" Width="72" Height="28" Padding="0" Click="BtnCanvasZoom_Click"/>
                            <TextBlock x:Name="TxtCursorInfo" Margin="16,0,0,0" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" VerticalAlignment="Center" Text="x,y"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT PANEL - PROPERTIES -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BrushSurfaceContainerLow}"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PropertiesPanel">
                                <TextBlock x:Name="LblMode"
                                           Text="MODE"
                                           Style="{StaticResource TextLabelCaps}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtModeInfo"
                                           Text="—"
                                           Style="{StaticResource TextBody}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="PALETTE"
                                           Style="{StaticResource TextLabelCaps}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbPalette"/>
                                <TextBlock x:Name="TxtPaletteInfo"
                                           Text="Limited by active hardware palette"
                                           Style="{StaticResource TextLabel}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,8,0,16"/>

                                <TextBlock Text="PIXEL INFO"
                                           Style="{StaticResource TextLabelCaps}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,6"/>

                                <TextBlock x:Name="TxtPixelCoord" Text="(0,0)" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtPixelColor" Text="Color" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,0,16"/>

                                <TextBlock Text="HINTS"
                                           Style="{StaticResource TextLabelCaps}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Lápis/Balde: clique/arraste. 
Seleção: arraste uma região. 
Espelho: aplica ao traço atual."
                                           Style="{StaticResource TextBody}"
                                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSurfaceContainerLow}"
                            Padding="16"
                            BorderBrush="{StaticResource BrushOnSurfaceVariant}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button x:Name="BtnCancel"
                                    Content="CANCEL"
                                    Click="BtnCancel_Click"
                                    Style="{StaticResource ButtonSecondary}"
                                    Margin="0,0,0,8"/>
                            <Button x:Name="BtnSave"
                                    Content="SAVE"
                                    Click="BtnSave_Click"
                                    Style="{StaticResource ButtonPrimary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurfaceContainerLow}"
                    CornerRadius="0,0,6,6"
                    Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtViewportInfo" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                        <TextBlock x:Name="TxtTileUsage" Style="{StaticResource TextLabel}" Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text=" " Width="1"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

