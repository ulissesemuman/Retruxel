// @retruxel:block header
void {{entityName}}_action_jump_press({{entityName}}_Params* p);
// @retruxel:end

// @retruxel:block source
// Action: jump — initiates jump; gravity handles hold window + jump cut passively
void {{entityName}}_action_jump_press({{entityName}}_Params* p) {
    {{#if params.onPress}}
    if (p->prev_button_held) return;
    {{/if}}
    {{#ifnot params.canDouble}}
    {{#if params.coyoteFrames}}
    if (!p->on_ground && p->coyote_frames == 0) return;
    {{/if}}
    {{#ifnot params.coyoteFrames}}
    if (!p->on_ground) return;
    {{/ifnot}}
    {{/ifnot}}
    {{#if params.canDouble}}
    if (p->jump_count >= 2) return;
    {{#if params.coyoteFrames}}
    if (p->on_ground || p->coyote_frames > 0) p->jump_count = 0;
    {{/if}}
    {{#ifnot params.coyoteFrames}}
    if (p->on_ground) p->jump_count = 0;
    {{/ifnot}}
    {{/if}}

    p->vel_y = -{{params.jumpHeight}};
    p->on_ground = 0;
    p->coyote_frames = 0;
    {{#if params.canDouble}}
    p->jump_count++;
    {{/if}}
    {{#if params.allowLongJump}}
    p->long_jump_active = 1;
    p->long_jump_timer = {{params.longJumpDuration}};
    {{/if}}
    {{#if params.onPress}}
    p->prev_button_held = 1;
    {{/if}}
}
// @retruxel:end
