// @retruxel:block header
// Generated by Retruxel — sms.input module
#ifndef INPUT_H
#define INPUT_H

#define INPUT_HOLD_THRESHOLD  {{holdThreshold}}

void          input_init(void);
void          input_update(void);

// Returns 1 while the button is held, 0 otherwise
{{#each mappedButtons}}
unsigned char input_{{this.action}}(void);
{{/each}}

// Returns 1 on the first frame the button is pressed (tap)
{{#each mappedButtons}}
unsigned char input_{{this.action}}_tap(void);
{{/each}}

// Returns 1 after the button has been held for INPUT_HOLD_THRESHOLD frames
{{#each mappedButtons}}
unsigned char input_{{this.action}}_held(void);
{{/each}}

#endif // INPUT_H
// @retruxel:end

// @retruxel:block source
// Generated by Retruxel — sms.input module
// DO NOT EDIT — regenerate from the Retruxel editor
#include "SMSlib.h"
#include "input.h"

static unsigned int  input_keys_current = 0;
static unsigned int  input_keys_pressed = 0;
{{#each mappedButtons}}
static unsigned char input_held_frames_{{this.action}} = 0;
{{/each}}

void input_init(void) {
    input_keys_current = 0;
    input_keys_pressed = 0;
{{#each mappedButtons}}
    input_held_frames_{{this.action}} = 0;
{{/each}}
}

// Call once per VBlank, before any game logic reads input
void input_update(void) {
    input_keys_pressed = SMS_getKeysPressed();
    input_keys_current = SMS_getKeysStatus();

{{#each mappedButtons}}
    if (input_keys_current & {{this.devkitConst}}) {
        if (input_held_frames_{{this.action}} < 255) input_held_frames_{{this.action}}++;
    } else {
        input_held_frames_{{this.action}} = 0;
    }
{{/each}}
}

{{#each mappedButtons}}
unsigned char input_{{this.action}}(void)      { return (input_keys_current & {{this.devkitConst}}) ? 1 : 0; }
unsigned char input_{{this.action}}_tap(void)  { return ((input_keys_pressed & {{this.devkitConst}}) && input_held_frames_{{this.action}} < {{holdThreshold}}) ? 1 : 0; }
unsigned char input_{{this.action}}_held(void) { return (input_held_frames_{{this.action}} >= {{holdThreshold}}) ? 1 : 0; }
{{/each}}
// @retruxel:end
