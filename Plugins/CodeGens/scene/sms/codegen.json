{
  "moduleId": "scene",
  "targetId": "sms",
  "displayName": "SMS Scene CodeGen",
  "description": "Generates scene initialization functions with palette, plane, and static text modules",
  "version": "1.0.0",
  "template": "scene.c.rtrx",
  "variables": {
    "sceneName": {
      "from": "scene",
      "path": "name",
      "default": "main"
    },
    "sceneNameUpper": {
      "from": "scene",
      "path": "name",
      "transform": "upper",
      "default": "MAIN"
    },
    "palette0Hex": {
      "from": "scenePaletteSlot",
      "slotIndex": 0
    },
    "palette1Hex": {
      "from": "scenePaletteSlot",
      "slotIndex": 1
    },
    "planeInits": {
      "from": "sceneModules",
      "filter": "moduleId == 'plane'",
      "transform": "initCall"
    },
    "textStaticInits": {
      "from": "sceneModules",
      "filter": "moduleId == 'text.display' && !dynamic",
      "transform": "initCall"
    },
    "hasGraphicModules": {
      "from": "sceneModules",
      "filter": "moduleId == 'plane' || (moduleId == 'text.display' && !dynamic)",
      "transform": "hasAny"
    }
  }
}
