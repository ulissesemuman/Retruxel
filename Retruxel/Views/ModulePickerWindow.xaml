<Window x:Class="Retruxel.Views.ModulePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADD MODULE"
        Height="640" Width="920"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <!-- Outer border — CornerRadius 6 permitido: moldura física da janela -->
    <Border CornerRadius="6"
            BorderBrush="#3a3a3a"
            BorderThickness="1"
            Background="{StaticResource BrushSurfaceContainerLow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title bar -->
                <RowDefinition Height="56"/>   <!-- Search -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="56"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushSurfaceContainerLow}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⊞"
                                   FontSize="16"
                                   Foreground="{StaticResource BrushPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ADD MODULE"
                                   Style="{StaticResource TextHeadline}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            Style="{StaticResource ButtonTitleBarClose}"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- ===== SEARCH ===== -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSurface}"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearch"
                             FontSize="13"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Tag="Search modules..."
                             TextChanged="TxtSearch_TextChanged"/>
                    <!-- Placeholder -->
                    <TextBlock x:Name="TxtSearchPlaceholder"
                               Text="🔍  Search modules..."
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- ===== MAIN CONTENT: sidebar + list ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>  <!-- Category sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Module list -->
                </Grid.ColumnDefinitions>

                <!-- ── CATEGORY SIDEBAR ── -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushSurface}">
                    <DockPanel>
                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                            <TextBlock Text="MODULE_TYPES"
                                       Style="{StaticResource TextLabelCaps}"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       FontSize="9"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtScopeLabel"
                                       Text="ALL"
                                       FontSize="8"
                                       FontFamily="Inter"
                                       Foreground="{StaticResource BrushPrimary}"
                                       Opacity="0.5"/>
                        </StackPanel>

                        <!-- Category buttons -->
                        <StackPanel DockPanel.Dock="Top" x:Name="CategoryPanel"/>

                        <!-- Decorative footer -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16" VerticalAlignment="Bottom">
                            <Border Height="4" Background="{StaticResource BrushSurfaceContainerHighest}">
                                <Border HorizontalAlignment="Left" Width="60" Height="4"
                                        Background="{StaticResource BrushPrimary}"/>
                            </Border>
                            <TextBlock Text="System.bus_idle"
                                       FontSize="8"
                                       FontFamily="Inter"
                                       Foreground="{StaticResource BrushOnSurfaceVariant}"
                                       Opacity="0.3"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── MODULE LIST ── -->
                <Border Grid.Column="1"
                        Background="{StaticResource BrushSurface}">
                    <ScrollViewer x:Name="ModuleListScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16">
                        <StackPanel x:Name="ModuleListPanel" Margin="0,0,0,8"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="3"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="0,0,6,6"
                    Padding="16,0">
                <Grid>
                    <!-- Status left -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="STATUS:"
                                   Style="{StaticResource TextLabelCaps}"
                                   FontSize="9"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStatus"
                                   Text="—"
                                   Style="{StaticResource TextLabelCaps}"
                                   FontSize="9"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                    </StackPanel>

                    <!-- Actions right -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="CANCEL"
                                Style="{StaticResource ButtonGhost}"
                                Padding="20,0" Height="36"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="BtnAdd"
                                Content="ADD MODULE"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="24,0" Height="36"
                                IsEnabled="False"
                                Click="BtnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
