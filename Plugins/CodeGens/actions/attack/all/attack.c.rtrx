// @retruxel:block header
void entity_{{entityId}}_action_attack(Entity_{{entityId}}_Params* p);
// @retruxel:end

// @retruxel:block source
// Action: attack — injected into entity_{{entityId}}
void entity_{{entityId}}_action_attack(Entity_{{entityId}}_Params* p) {
    if (p->attack_cooldown > 0) return;
    p->attacking = 1;
    p->attack_damage = {{params.damage}};
    p->attack_range = {{params.range}};
    p->attack_cooldown = {{params.cooldown}};
}
// @retruxel:end
