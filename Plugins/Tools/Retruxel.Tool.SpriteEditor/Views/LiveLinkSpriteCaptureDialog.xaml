<Window x:Class="Retruxel.Tool.SpriteEditor.Views.LiveLinkSpriteCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveLink — Capture Sprite Tiles"
        Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushOutlineVariant}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Asset name" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAssetName" Text="sprite" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Start tile" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtStartTile" Text="256" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Tile count" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTileCount" Grid.Column="0" Text="32" Height="32" TextChanged="TxtTileCount_TextChanged"/>
                    <TextBlock x:Name="TxtVramSize" Grid.Column="2" Text="(1024 bytes)" 
                           Style="{StaticResource TextLabel}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="6" 
                   Text="Common: SMS sprites start at tile 256"
                   Style="{StaticResource TextLabel}"
                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Style="{StaticResource ButtonGhost}" 
                    Click="BtnCancel_Click" Width="80" Height="32" Margin="0,0,8,0"/>
                <Button Content="CAPTURE" Style="{StaticResource ButtonPrimary}" 
                    Click="BtnCapture_Click" Width="90" Height="32"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
