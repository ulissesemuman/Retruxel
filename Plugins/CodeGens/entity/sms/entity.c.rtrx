// @retruxel:module entity
// @retruxel:target sms
// @retruxel:version 2.8.0

// @retruxel:block header
// Generated by Retruxel — entity module (SMS). Do not edit manually.
#ifndef ENTITY_{{instanceId}}_H
#define ENTITY_{{instanceId}}_H

#include "SMSlib.h"

// SAT slot assigned by SatAllocator ({{widthTiles}}x{{heightTiles}} hardware sprites)
#define ENTITY_{{instanceId}}_SAT_INDEX    {{satIndex}}
// VRAM tile offset assigned by VramAllocator
#define ENTITY_{{instanceId}}_START_TILE   {{startTile}}
// Sprite render grid dimensions in 8x8 tiles
#define ENTITY_{{instanceId}}_WIDTH_TILES  {{widthTiles}}
#define ENTITY_{{instanceId}}_HEIGHT_TILES {{heightTiles}}

{{#if hasPrefabActions}}
// ── Prefab params struct ──────────────────────────────────────────────────────
typedef struct {
    int           vel_x;
    int           vel_y;
    unsigned char on_ground;
    unsigned char jump_count;
    unsigned char attacking;
    unsigned char attack_cooldown;
    unsigned char attack_damage;
    unsigned char attack_range;
} Entity_{{instanceId}}_Params;
{{/if}}

typedef struct {
    int           x;
    int           y;
    signed char   vx;
    signed char   vy;
    unsigned char health;
    unsigned char speed;
{{#if hasPrefabActions}}
    Entity_{{instanceId}}_Params params;
{{/if}}
} Entity_{{instanceId}};

extern Entity_{{instanceId}} entity_{{instanceId}};

void entity_{{instanceId}}_init(void);
void entity_{{instanceId}}_update(void);

{{#if hasPrefabActions}}
// Action function declarations
{{#each actions}}
{{actionDecl}}
{{/each}}
{{/if}}

#endif // ENTITY_{{instanceId}}_H
// @retruxel:end

// @retruxel:block source
// Generated by Retruxel — entity module (SMS). Do not edit manually.
#include "SMSlib.h"
#include "entity_{{instanceId}}.h"
{{#if collisionPlaneId}}
#include "plane_{{collisionPlaneId}}.h"
{{/if}}

// ── Tile data ─────────────────────────────────────────────────────────────────
{{#if isFirstInstanceWithAsset}}
// Tile data from asset: {{spriteAssetId}} — {{tilesData.tileCount}} tiles, {{tilesData.totalBytes}} bytes
const unsigned char {{spriteAssetId}}[] = { {{tilesData.tilesHex}} };
{{/if}}
{{#if isNotFirstInstanceWithAsset}}
extern const unsigned char {{spriteAssetId}}[];
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
static const unsigned char entity_{{instanceId}}_placeholder_tiles[] = { 0 };
{{/if}}

Entity_{{instanceId}} entity_{{instanceId}};

// ── Action functions ──────────────────────────────────────────────────────────
{{#if hasPrefabActions}}
{{#each actions}}
{{actionBody}}
{{/each}}
{{/if}}

void entity_{{instanceId}}_init(void) {
    entity_{{instanceId}}.x      = {{x}};
    entity_{{instanceId}}.y      = {{y}};
    entity_{{instanceId}}.vx     = 0;
    entity_{{instanceId}}.vy     = 0;
    entity_{{instanceId}}.health = {{health}};
    entity_{{instanceId}}.speed  = {{speed}};

{{#if isFirstInstanceWithAsset}}
    SMS_loadTiles({{spriteAssetId}}, ENTITY_{{instanceId}}_START_TILE, sizeof({{spriteAssetId}}));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}
{{#if isFirstInstanceWithoutAsset}}
    SMS_loadTiles(entity_{{instanceId}}_placeholder_tiles, ENTITY_{{instanceId}}_START_TILE, sizeof(entity_{{instanceId}}_placeholder_tiles));
    SMS_useFirstHalfTilesforSprites({{useFirstHalfTiles}});
{{/if}}

    SMS_initSprites();
    SMS_copySpritestoSAT();
}

void entity_{{instanceId}}_update(void) {
{{#if hasInputMapping}}
    // ── Input → Action mapping ────────────────────────────────────────────────
    {
{{#each actions}}
{{actionReset}}
{{/each}}
{{#each inputMappings}}
{{#each actionCalls}}
        if ({{keysFunc}}() & {{devkitConst}}) {
            entity_{{entityId}}_action_{{actionId}}(&entity_{{instanceId}}.params{{#if callArgs}}, {{callArgs}}{{/if}});
        }
{{/each}}
{{/each}}
    }
{{/if}}

    // ── Auto-update actions (gravity, etc.) ───────────────────────────────────
{{#if hasPrefabActions}}
{{#each actions}}
{{actionUpdate}}
{{/each}}
{{/if}}

    // ── Apply physics + tilemap collision ─────────────────────────────────────
{{#if hasPrefabActions}}
    {
        int next_x = entity_{{instanceId}}.x + entity_{{instanceId}}.params.vel_x;
        int next_y = entity_{{instanceId}}.y + (entity_{{instanceId}}.params.vel_y >> 3);

        // Tile coordinates of the bottom-center of the sprite
        unsigned char foot_tx = (unsigned char)((next_x + (ENTITY_{{instanceId}}_WIDTH_TILES  * 4)) >> 3);
        unsigned char foot_ty = (unsigned char)((next_y +  ENTITY_{{instanceId}}_HEIGHT_TILES  * 8) >> 3);

        // ── Vertical collision ───────────────────────────────────────────────
        entity_{{instanceId}}.params.on_ground = 0;
{{#if collisionPlaneId}}
        if (entity_{{instanceId}}.params.vel_y >= 0 &&
            foot_ty < PLANE_{{collisionPlaneId}}_MAP_HEIGHT &&
            foot_tx < PLANE_{{collisionPlaneId}}_MAP_WIDTH  &&
            plane_{{collisionPlaneId}}_solid_at(foot_tx, foot_ty))
        {
            // Snap to top of the solid tile
            next_y = (int)(foot_ty * 8) - (ENTITY_{{instanceId}}_HEIGHT_TILES * 8);
            entity_{{instanceId}}.params.vel_y  = 0;
            entity_{{instanceId}}.params.on_ground = 1;
            entity_{{instanceId}}.params.jump_count = 0;
        }
{{/if}}

        entity_{{instanceId}}.x = next_x;
        entity_{{instanceId}}.y = next_y;

        if (entity_{{instanceId}}.params.attack_cooldown > 0)
            entity_{{instanceId}}.params.attack_cooldown--;
    }
{{/if}}

    // ── Draw sprite ───────────────────────────────────────────────────────────
    SMS_initSprites();
    {
        unsigned char _row, _col;
        for (_row = 0; _row < ENTITY_{{instanceId}}_HEIGHT_TILES; _row++) {
            for (_col = 0; _col < ENTITY_{{instanceId}}_WIDTH_TILES; _col++) {
                unsigned char _tile_idx = _row * ENTITY_{{instanceId}}_WIDTH_TILES + _col;
                SMS_addSprite(
                    (unsigned char)(entity_{{instanceId}}.x + _col * 8),
                    (unsigned char)(entity_{{instanceId}}.y + _row * 8),
                    (unsigned char)((ENTITY_{{instanceId}}_START_TILE + _tile_idx) % 256));
            }
        }
    }
    SMS_copySpritestoSAT();
}
// @retruxel:end
