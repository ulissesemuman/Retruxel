{
  "moduleId": "entity",
  "targetId": "sms",
  "version": "2.6.0",
  "template": "entity.c.rtrx",
  "variables": {
    "x":               { "from": "module", "path": "startTileX",      "default": 120 },
    "y":               { "from": "module", "path": "startTileY",      "default": 144 },
    "startTile":       { "from": "module", "path": "startTile",       "default": 256 },
    "satIndex":        { "from": "module", "path": "satIndex",        "default": 0 },
    "widthTiles":      { "from": "module", "path": "widthTiles",      "default": 2 },
    "heightTiles":     { "from": "module", "path": "heightTiles",     "default": 2 },
    "speed":           { "from": "module", "path": "speed",           "default": 2 },
    "health":          { "from": "module", "path": "health",          "default": 3 },
    "usePhysics":      { "from": "module", "path": "usePhysics",      "default": false },
    "useInput":        { "from": "module", "path": "useInput",        "default": false },
    "useAnimation":    { "from": "module", "path": "useAnimation",    "default": false },
    "spriteAssetId":   { "from": "module", "path": "spriteAssetId",   "default": "" },
    "prefabId":        { "from": "module", "path": "prefabId",        "default": "" },
    "hasPrefabActions":{ "from": "module", "path": "hasPrefabActions","default": false },
    "hasInputMapping": { "from": "module", "path": "hasInputMapping", "default": false },
    "actions":         { "from": "module", "path": "actions",         "default": [] },
    "inputMappings":   { "from": "module", "path": "inputMappings",   "default": [] },
    "tilesData": {
      "from": "tool",
      "tool": "png_to_tiles",
      "toolInput": {
        "assetId": "spriteAssetId"
      }
    }
  }
}
