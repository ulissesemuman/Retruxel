<Window x:Class="Retruxel.Tool.SpriteEditor.SpriteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPRITE EDITOR"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DropShadowEffect x:Key="WindowShadow"
                              Color="Black" Direction="270"
                              ShadowDepth="8" BlurRadius="32" Opacity="0.6"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="6"
            Background="{StaticResource BrushSurface}"
            BorderBrush="#3a3a3a"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceContainerLow}" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="SPRITE EDITOR" 
                               Style="{StaticResource TextHeadline}"
                               Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock x:Name="TxtSpriteName" Text="" 
                               Style="{StaticResource TextHeadline}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="SAVE" Style="{StaticResource ButtonPrimary}" 
                            Click="BtnSave_Click" Width="80" Height="32" Margin="0,0,8,0"/>
                        <Button Content="✕" Style="{StaticResource ButtonTitleBarClose}" 
                            Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                <!-- Left: Tileset Panel -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainerLow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="TILESET" 
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="16,8"/>

                        <!-- Asset Selector -->
                        <StackPanel Grid.Row="1" Margin="16,8,16,0">
                            <TextBlock Text="Asset" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbTilesetAsset" Grid.Column="0" Height="32"/>
                                <Button x:Name="BtnBrowseTileset" Grid.Column="2" Content="..." 
                                    Style="{StaticResource ButtonSecondary}" Width="32" Height="32"
                                    Click="BtnBrowseTileset_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Palette Slot Selector -->
                        <StackPanel Grid.Row="2" Margin="16,8,16,0">
                            <TextBlock Text="Palette Slot" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbPaletteSlot" Grid.Column="0" Height="32"/>
                                <Button x:Name="BtnEditPalette" Grid.Column="2" Content="EDIT" 
                                    Style="{StaticResource ButtonSecondary}" Width="48" Height="32"/>
                            </Grid>
                        </StackPanel>

                        <!-- Zoom Controls -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,8,16,8">
                            <TextBlock Text="Zoom:" Style="{StaticResource TextLabel}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnTilesetZoom50" Content="50%" 
                                Style="{StaticResource ButtonSecondary}" Width="48" Height="24"/>
                            <Button x:Name="BtnTilesetZoom100" Content="100%" 
                                Style="{StaticResource ButtonPrimary}" Width="48" Height="24" Margin="4,0,0,0"/>
                            <Button x:Name="BtnTilesetZoom200" Content="200%" 
                                Style="{StaticResource ButtonSecondary}" Width="48" Height="24" Margin="4,0,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="4" x:Name="TilesetScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TilesetItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Width="208"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Center: Composition Canvas -->
                <Border Grid.Column="1" Background="{StaticResource BrushSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="COMPOSITION" 
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="16,8"/>

                        <!-- Canvas Zoom Controls -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8,16,8">
                            <TextBlock Text="Zoom:" Style="{StaticResource TextLabel}" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnCanvasZoom50" Content="50%" 
                                Style="{StaticResource ButtonSecondary}" Width="48" Height="24"/>
                            <Button x:Name="BtnCanvasZoom100" Content="100%" 
                                Style="{StaticResource ButtonSecondary}" Width="48" Height="24" Margin="4,0,0,0"/>
                            <Button x:Name="BtnCanvasZoom200" Content="200%" 
                                Style="{StaticResource ButtonPrimary}" Width="48" Height="24" Margin="4,0,0,0"/>
                            <Button x:Name="BtnCanvasZoom400" Content="400%" 
                                Style="{StaticResource ButtonSecondary}" Width="48" Height="24" Margin="4,0,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" x:Name="CanvasScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="CompositionCanvas" 
                                Width="512" Height="512"
                                Background="{StaticResource BrushSurfaceContainerHigh}"
                                AllowDrop="True"
                                Drop="Canvas_Drop"
                                DragOver="Canvas_DragOver"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Frames & Animation Panel -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceContainerLow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <!-- Frames List -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="FRAMES" 
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Margin="16,8"/>

                            <ListBox Grid.Row="1" x:Name="FramesListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="FramesListBox_SelectionChanged"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                                <Button Content="+" Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnAddFrame_Click" Width="60" Height="32"/>
                                <Button Content="DUPLICATE" Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnDuplicateFrame_Click" Width="90" Height="32" Margin="8,0,0,0"/>
                                <Button Content="−" Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnDeleteFrame_Click" Width="60" Height="32" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hitboxes Panel -->
                        <Grid Grid.Row="1" Background="{StaticResource BrushSurface}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="HITBOXES" 
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Margin="16,8"/>

                            <ListBox Grid.Row="1" x:Name="HitboxesListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="8,0"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                                <Button Content="+" Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnAddHitbox_Click" Width="80" Height="32"/>
                                <Button Content="−" Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnDeleteHitbox_Click" Width="80" Height="32" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Animation Preview -->
                        <Grid Grid.Row="2" Background="{StaticResource BrushSurface}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="PREVIEW" 
                                   Style="{StaticResource TextLabelCaps}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"
                                   Margin="16,8"/>

                            <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainerHigh}"
                                Margin="16,0">
                                <Canvas x:Name="PreviewCanvas" 
                                    Width="128" Height="128"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                                <Button x:Name="BtnPlayPause" Content="▶" 
                                    Style="{StaticResource ButtonSecondary}" 
                                    Click="BtnPlayPause_Click" Width="40" Height="32"/>
                                <CheckBox x:Name="ChkLoop" Content="LOOP" 
                                      IsChecked="True"
                                      Foreground="{StaticResource BrushOnSurface}"
                                      VerticalAlignment="Center" 
                                      Margin="16,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainerLow}" 
                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatusInfo" Text="Ready" 
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Duration:" Style="{StaticResource TextLabel}" 
                                   Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtFrameDuration" Width="48" Height="24" 
                                 Text="100" TextAlignment="Center"
                                 Background="{StaticResource BrushSurfaceContainerHigh}"
                                 Foreground="{StaticResource BrushOnSurface}"
                                 BorderBrush="{StaticResource BrushOutlineVariant}"
                                 TextChanged="TxtFrameDuration_TextChanged"/>
                            <TextBlock Text="ms" Style="{StaticResource TextLabel}" 
                                   Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="4,0,16,0"/>
                            <TextBlock x:Name="TxtVramInfo" Text="VRAM: 0 tiles (0 bytes)" 
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtFrameInfo" Text="Frame: 0/0" 
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtSpriteSize" Text="Size: 0×0" 
                                   Style="{StaticResource TextLabel}"
                                   Foreground="{StaticResource BrushOnSurfaceVariant}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
