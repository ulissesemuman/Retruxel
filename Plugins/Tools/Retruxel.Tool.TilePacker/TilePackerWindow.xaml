<Window x:Class="Retruxel.Tool.TilePacker.TilePackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TILE PACKER"
        Width="1100" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSurfaceContainerLow}"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="640">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Retruxel;component/Themes/RetruxelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurfaceContainerHigh}"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="TILE DEDUPLICATION PREVIEW"
                           Style="{StaticResource TextLabelCaps}"
                           Foreground="{StaticResource BrushOnSurface}"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="Visual deduplication by palette index"
                           Style="{StaticResource TextLabel}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Before / After previews -->
        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurfaceContainerHigh}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="ORIGINAL TILESET"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgOriginal"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource BrushSurfaceContainerHigh}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="OPTIMIZED (UNIQUE TILES)"
                               Style="{StaticResource TextLabelCaps}"
                               Foreground="{StaticResource BrushOnSurfaceVariant}"
                               Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgOptimized"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Stats + options -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurfaceContainerHigh}"
                Margin="16,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="TxtStats"
                               Text="Original: 0  ·  Unique: 0  ·  Saved: 0 (0%)"
                               Style="{StaticResource TextBody}"
                               Foreground="{StaticResource BrushOnSurface}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="ChkFlipH"
                              Content="Flip H"
                              IsChecked="True"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Checked="PackOptions_Changed"
                              Unchecked="PackOptions_Changed"/>
                    <CheckBox x:Name="ChkFlipV"
                              Content="Flip V"
                              IsChecked="True"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Checked="PackOptions_Changed"
                              Unchecked="PackOptions_Changed"/>
                    <CheckBox x:Name="ChkRotation"
                              Content="Rotation"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Checked="PackOptions_Changed"
                              Unchecked="PackOptions_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tile mapping -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushSurfaceContainerHigh}"
                Margin="16,8,16,0"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="TILE MAPPING"
                           Style="{StaticResource TextLabelCaps}"
                           Foreground="{StaticResource BrushOnSurfaceVariant}"
                           Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1"
                          x:Name="GridMapping"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="{StaticResource BrushSurface}"
                          BorderThickness="0"
                          RowHeight="28"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="70"/>
                        <DataGridTextColumn Header="SRC #" Binding="{Binding SourceIndex}" Width="60"/>
                        <DataGridTextColumn Header="MAP #" Binding="{Binding MappedIndex}" Width="60"/>
                        <DataGridTextColumn Header="TRANSFORM" Binding="{Binding Transform}" Width="80"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushSurfaceContainerHigh}"
                Padding="16"
                Margin="0,8,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BrushSurfaceContainerHighest}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Style="{StaticResource ButtonGhost}"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button Content="APPLY"
                        Style="{StaticResource ButtonPrimary}"
                        Width="100"
                        Click="BtnApply_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
