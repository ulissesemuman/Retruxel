// @retruxel:block header
void entity_{{entityId}}_action_gravity(Entity_{{entityId}}_Params* p);
// @retruxel:end

// @retruxel:block source
// Action: gravity — injected into entity_{{entityId}}
void entity_{{entityId}}_action_gravity(Entity_{{entityId}}_Params* p) {
    if (p->on_ground) return;
    p->vel_y += {{params.strength}};
    if (p->vel_y > {{params.maxFallSpeed}}) p->vel_y = {{params.maxFallSpeed}};
}
// @retruxel:end

// @retruxel:block physics
    entity_{{entityId}}.x += entity_{{entityId}}.params.vel_x;
    entity_{{entityId}}.y += entity_{{entityId}}.params.vel_y;
    if (entity_{{entityId}}.y >= {{params.groundY}}) {
        entity_{{entityId}}.y = {{params.groundY}};
        entity_{{entityId}}.params.vel_y  = 0;
        entity_{{entityId}}.params.on_ground = 1;
        entity_{{entityId}}.params.jump_count = 0;
    } else {
        entity_{{entityId}}.params.on_ground = 0;
    }
// @retruxel:end
