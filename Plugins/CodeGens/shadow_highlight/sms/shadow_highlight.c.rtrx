// @retruxel:block header
// Shadow/Highlight mode for SMS VDP
// Generated by Retruxel — do not edit manually.
#ifndef SHADOW_HIGHLIGHT_H
#define SHADOW_HIGHLIGHT_H

#include "SMSlib.h"

/**
 * Shadow/Highlight mode expands the SMS palette from 64 to 192 effective colors.
 *
 * How it works:
 *   - Normal sprites render as usual.
 *   - A sprite tile using color index 0x3E acts as a SHADOW: any BG tile behind it
 *     is displayed at half brightness (darkened).
 *   - A sprite tile using color index 0x3F acts as a HIGHLIGHT: any BG tile behind it
 *     is displayed at double brightness (lightened), or as shadow if already shadowed.
 *
 * Activation:
 *   - Bit 3 of VDP register #0 must be set (SMS_VDPturnOnFeature 0x08 equivalent).
 *   - SMSlib exposes SMS_setShadowHighlight() for this purpose.
 *
 * Usage in your codegen:
 *   - Call shadow_highlight_init() once in scene_init() to activate the mode.
 *   - Add SAT entries using color byte 0x3E (shadow) or 0x3F (highlight) as needed.
 */

void shadow_highlight_init(void);
void shadow_highlight_disable(void);

#endif // SHADOW_HIGHLIGHT_H
// @retruxel:end

// @retruxel:block source
#include "shadow_highlight.h"

void shadow_highlight_init(void) {
{{#if enabled}}
    // Enable Shadow/Highlight via VDP register 0, bit 3
    // SMS_VDP_DISP_ON | SMS_VDP_FRAME_INT_ON | SMS_VDP_SHADOW_HIGHLIGHT_ON
    SMS_write_to_VDP_register(0, 0x0E);   // bits: ExternalSync=0, M2=0, M4=1, SHL=1
{{/if}}
}

void shadow_highlight_disable(void) {
    SMS_write_to_VDP_register(0, 0x06);   // SHL bit cleared
}
// @retruxel:end
