// Generated by Retruxel GameVar CodeGen

#ifndef GAMEVARS_H
#define GAMEVARS_H

{{#each vars}}
// {{this.name}} — type: {{this.type}}, initial: {{this.initialValue}}
{{#if this.type == 'int'}}
extern int g_{{this.name}};
{{/if}}
{{#if this.type == 'byte'}}
extern unsigned char g_{{this.name}};
{{/if}}
{{#if this.type == 'bool'}}
extern unsigned char g_{{this.name}};
{{/if}}
{{/each}}

{{#if hasIntOrByte}}
// Utility: Converts unsigned int to decimal string (no sprintf on SDCC)
void retruxel_uint_to_str(unsigned int n, char* buf, unsigned char width);
{{/if}}

{{#if hasEventBindings}}
// Event IDs
{{#each eventIds}}
#define {{this.define}} {{this.index}}
{{/each}}
#define RETRUXEL_EVENT_BUS
#define EVENT_EMIT(ev) event_bus_dispatch(ev)
void event_bus_dispatch(unsigned char event_id);
{{/if}}
{{#ifnot hasEventBindings}}
#define EVENT_EMIT(ev)
{{/ifnot}}

#endif

// gamevars.c

#include "gamevars.h"

{{#each vars}}
// {{this.name}} — type: {{this.type}}, initial: {{this.initialValue}}
{{#if this.type == 'int'}}
int g_{{this.name}} = {{this.initialValue}};
{{/if}}
{{#if this.type == 'byte'}}
unsigned char g_{{this.name}} = {{this.initialValue}};
{{/if}}
{{#if this.type == 'bool'}}
unsigned char g_{{this.name}} = {{this.initialValue}};
{{/if}}

{{/each}}

{{#if hasIntOrByte}}
// Utility: Converts unsigned int to decimal string (no sprintf on SDCC)
void retruxel_uint_to_str(unsigned int n, char* buf, unsigned char width) {
    unsigned char i;
    for (i = 0; i < width; i++) {
        buf[width - 1 - i] = '0' + (unsigned char)(n % 10);
        n /= 10;
    }
    buf[width] = '\0';
}
{{/if}}

{{#if hasEventBindings}}
// Event Bus — dispatches variable mutations triggered by action events
void event_bus_dispatch(unsigned char event_id) {
    switch (event_id) {
{{#each bindingGroups}}
        case {{this.eventDefine}}:
{{#each this.bindings}}
{{#if this.condition}}
            if ({{this.condition}}) {
{{/if}}
{{#if this.operation == 'Set'}}
            g_{{this.variableName}} = {{this.value}};
{{/if}}
{{#if this.operation == 'Add'}}
            g_{{this.variableName}} += {{this.value}};
{{/if}}
{{#if this.operation == 'Subtract'}}
            g_{{this.variableName}} -= {{this.value}};
{{/if}}
{{#if this.operation == 'Toggle'}}
            g_{{this.variableName}} = !g_{{this.variableName}};
{{/if}}
{{#if this.operation == 'Reset'}}
            g_{{this.variableName}} = {{this.initialValue}};
{{/if}}
{{#if this.condition}}
            }
{{/if}}
{{/each}}
            break;
{{/each}}
        default:
            break;
    }
}
{{/if}}
